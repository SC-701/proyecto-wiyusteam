@page
@model Web.Pages.Bautismos.EditarModel

<div class="container mt-5" style="max-width: 900px;">

    <div class="card-liturgica-form">

        <div class="form-header-liturgico">
            <h3>Editar Bautismo</h3>
            <span class="badge-liturgico">Actualización</span>
        </div>

        <hr class="linea-dorada" />

        <form method="post">

            <div class="row g-3">

                <!-- BAUTIZANDO -->
                <div class="col-md-6">
                    <label>Bautizando</label>
                    <select asp-for="bautismo.BautizandoId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <!-- PADRES -->
                <div class="col-md-6">
                    <label>Padre</label>
                    <select asp-for="bautismo.PadreId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Madre</label>
                    <select asp-for="bautismo.MadreId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <!-- ABUELOS -->
                <div class="col-md-6">
                    <label>Abuelo Paterno</label>
                    <select asp-for="bautismo.AbueloPaternoId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Abuela Paterna</label>
                    <select asp-for="bautismo.AbuelaPaternaId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Abuelo Materno</label>
                    <select asp-for="bautismo.AbueloMaternoId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Abuela Materna</label>
                    <select asp-for="bautismo.AbuelaMaternaId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <!-- PADRINOS -->
                <div class="col-md-6">
                    <label>Padrino</label>
                    <select asp-for="bautismo.PadrinoId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label>Madrina</label>
                    <select asp-for="bautismo.MadrinaId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <!-- DECLARANTE -->
                <div class="col-md-6">
                    <label>Declarante</label>
                    <select asp-for="bautismo.DeclaranteId" class="form-control input-liturgico">
                        <option value="">Seleccione</option>
                        @foreach (var p in Model.Personas)
                        {
                            <option value="@p.Id">@p.Nombre @p.PrimerApellido</option>
                        }
                    </select>
                </div>

                <!-- DATOS -->
                <div class="col-md-6">
                    <label>Tipo Unión</label>
                    <input asp-for="bautismo.TipoUnionPadres" class="form-control input-liturgico" />
                </div>

                <div class="col-md-6">
                    <label>Fecha Matrimonio</label>
                    <input type="date" asp-for="bautismo.FechaMatrimonioPadres" class="form-control input-liturgico" />
                </div>

            </div>

            <input type="hidden" asp-for="bautismo.Id" />

            <div class="text-danger mt-3" asp-validation-summary="All"></div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-page="./Index" class="btn btn-liturgico-outline">← Regresar</a>
                <button type="submit" class="btn btn-liturgico">Guardar Cambios</button>
            </div>

        </form>

    </div>

</div>